{{ render_template("ostimnet_intents_definitions\\ostimnet_intent_lustful_willingness") }}

#### If intent is transactional
{{ render_template("ostimnet_intents_definitions\\ostimnet_intent_transactional_roles") }}
{{ render_template("ostimnet_intents_definitions\\ostimnet_intent_transactional_willingness") }}

#### If intent is dom
